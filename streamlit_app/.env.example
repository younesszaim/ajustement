POSTGRES_URL=postgresql://user:password@host:5432/postgres
POSTGRES_SCHEMA=adjustment_simple
# Use postgres with project.supabase.yaml to simulate Vertica in Supabase.
OUTPUT_DATABASE=vertica
VERTICA_HOST=vertica-host
VERTICA_PORT=5433
VERTICA_DATABASE=limon
VERTICA_USER=limon_user
VERTICA_PASSWORD=change-me
VERTICA_TIMEOUT=10
ADJUSTMENT_ACTOR=limon-user
LIMON_PROJECT_CONFIG=streamlit_app/project.yaml
LIMON_API_URL=http://127.0.0.1:8001
# Development only: pause each executed calculation stage for UI testing.
SIMULATED_CALCULATION_DELAY_SECONDS=0
