# One database, two schemas: vertica_sim and adjustment_meta.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
ADJUSTMENT_PROJECT_KEY=limon_ldp_bmf
# JSON object mapping each mapping name to its latest immutable Parquet path.
MAPPING_MANIFEST_PATH=mapping_data/latest_mappings.json
SIMULATED_FAILURE_POINT=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_PORT=8001
# Technical actor written to audit events while authentication is not enabled.
AUDIT_ACTOR=local-user
