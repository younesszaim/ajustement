# SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# ADJUSTMENT_PROJECT_KEY=limon_ldp_bmf
# STORAGE_MODE=supabase
# Real LiMon deployment:
# Two-schema Supabase simulation of the hybrid transaction boundary:
STORAGE_MODE=hybrid_sim
OUTPUT_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
METADATA_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SIMULATED_FAILURE_POINT=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_PORT=8000
# Development SSO. Use a long random secret and never expose it to Vite.
AUTH_MODE=mock
AUTH_SESSION_SECRET=replace-with-a-long-random-development-secret
AUTH_COOKIE_SECURE=false
#
# Real LiMon deployment:
# STORAGE_MODE=hybrid
# VERTICA_HOST=
# VERTICA_PORT=5433
# VERTICA_DATABASE=
# VERTICA_USER=
# VERTICA_PASSWORD=
# VERTICA_SCHEMA=
# VERTICA_OUTPUT_TABLE=output_completude_table
# LIMON_VERTICA_CONNECTION_FACTORY=limon.db:open_vertica_connection
# Production must replace mock mode with the CACIB identity provider and use
# secure cookies. Mock login endpoints are disabled when AUTH_MODE is not mock.
# AUTH_MODE=cacib_sso
# AUTH_COOKIE_SECURE=true
