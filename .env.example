# One database, two schemas: vertica_sim and adjustment_meta.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
ADJUSTMENT_PROJECT_KEY=limon_ldp_bmf
# JSON object mapping each mapping name to its latest immutable Parquet path.
MAPPING_MANIFEST_PATH=mapping_data/latest_mappings.json
SIMULATED_FAILURE_POINT=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_PORT=8001
# Development SSO. Use a long random secret and never expose it to Vite.
AUTH_MODE=mock
AUTH_SESSION_SECRET=replace-with-a-long-random-development-secret
AUTH_COOKIE_SECURE=false
#
# Production must replace mock mode with the CACIB identity provider and use
# secure cookies. Mock login endpoints are disabled when AUTH_MODE is not mock.
# AUTH_MODE=cacib_sso
# AUTH_COOKIE_SECURE=true
